generator client {
  provider = "prisma-client-js"
  output   = "../generated/sqlserver-client"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Area {
  id             String            @id @default(uuid()) @db.UniqueIdentifier
  nombre         String            @unique @db.VarChar(100)
  colorHex       String            @map("color_hex") @db.VarChar(7)
  createdAt      DateTime          @default(now()) @map("created_at")
  usuarios       Usuario[]
  iniciativas    Iniciativa[]
  solicitudes    SolicitudCambio[]
  eventos        Evento[]
  requerimientos Requerimiento[]
  flujos         FlujoArea[]

  @@map("areas")
}

model ObjetivoNegocio {
  creadorId   String?            @map("creador_id") @db.UniqueIdentifier
  areaId      String?            @map("area_id") @db.UniqueIdentifier
  id          String             @id @default(uuid()) @db.UniqueIdentifier
  nombre      String             @db.VarChar(150)
  descripcion String? @db.NVarChar(Max)
  createdAt   DateTime           @default(now()) @map("created_at")
  deletedAt   DateTime?          @map("deleted_at")
  deletedById String?            @map("deleted_by_id") @db.UniqueIdentifier
  iniciativas Iniciativa[]
  progresos   ObjetivoProgreso[]

  @@map("objetivos_negocio")
}

model ObjetivoProgreso {
  id         String          @id @default(uuid()) @db.UniqueIdentifier
  objetivoId String          @map("objetivo_id") @db.UniqueIdentifier
  usuarioId  String          @map("usuario_id") @db.UniqueIdentifier
  porcentaje Int
  comentario String          @db.VarChar(1000)
  createdAt  DateTime        @default(now()) @map("created_at")
  objetivo   ObjetivoNegocio @relation(fields: [objetivoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario    Usuario         @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([objetivoId, createdAt], map: "idx_objetivo_progresos_fecha")
  @@map("objetivo_progresos")
}

model Usuario {
  id                      String              @id @default(uuid()) @db.UniqueIdentifier
  nombres                 String              @db.VarChar(100)
  apellidos               String              @db.VarChar(100)
  email                   String              @unique @db.VarChar(150)
  passwordHash            String              @map("password_hash") @db.VarChar(255)
  areaId                  String              @map("area_id") @db.UniqueIdentifier
  cargo                   String
  rol                     String
  portalColor             String              @default("#0B2347") @map("portal_color") @db.VarChar(7)
  darkMode                Boolean             @default(false) @map("dark_mode")
  fotoPerfil              String?             @map("foto_perfil") @db.NVarChar(Max)
  estadoMensaje           String              @default("Disponible") @map("estado_mensaje") @db.VarChar(20)
  resetTokenHash          String?             @map("reset_token_hash") @db.VarChar(64)
  resetExpires            DateTime?           @map("reset_expires")
  emailVerifiedAt         DateTime?           @map("email_verified_at")
  verificationTokenHash   String?             @map("verification_token_hash") @db.VarChar(64)
  failedLoginAttempts     Int                 @default(0) @map("failed_login_attempts")
  lockedUntil             DateTime?           @map("locked_until")
  permisos                String              @default("{}") @db.NVarChar(Max)
  notificationPreferences String              @default("{}") @map("notification_preferences") @db.NVarChar(Max)
  onboardingCompleted     Boolean             @default(false) @map("onboarding_completed")
  isSuperAdmin            Boolean             @default(false) @map("is_super_admin")
  createdAt               DateTime            @default(now()) @map("created_at")
  area                    Area                @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  iniciativas             Iniciativa[]        @relation("Responsable")
  progresos               Progreso[]
  progresosObjetivo       ObjetivoProgreso[]
  mensajesEnviados        Mensaje[]           @relation("MensajesEnviados")
  mensajesRecibidos       Mensaje[]           @relation("MensajesRecibidos")
  reaccionesMensaje       MensajeReaccion[]
  mensajesProgramados     MensajeProgramado[] @relation("MensajesProgramados")
  huddlesIniciados        Huddle[]            @relation("HuddlesIniciados")
  solicitudesCreadas      SolicitudCambio[]   @relation("SolicitudesCreadas")
  solicitudesAprobadas    SolicitudCambio[]   @relation("SolicitudesAprobadas")
  eventosCreados          Evento[]            @relation("EventosCreados")
  eventosAsignados        Evento[]            @relation("EventosAsignados")
  requerimientos          Requerimiento[]
  flujosSubidos           FlujoArea[]
  registrosPortal         RegistroPortal[]
  comentariosTarea        TareaComentario[]
  tareasAsignadas         TareaIniciativa[]   @relation("TareasAsignadas")
  notificaciones          Notificacion[]
  ticketsCreados          Ticket[]            @relation("TicketsCreados")
  ticketsAsignados        Ticket[]            @relation("TicketsAsignados")
  ticketsFinalizados      Ticket[]            @relation("TicketsFinalizados")
  historialTickets        TicketHistorial[]
  prospectosCreados       Prospecto[]

  @@map("usuarios")
}

model Cliente {
  id          String            @id @default(uuid()) @db.UniqueIdentifier
  ruc         String?           @unique @db.VarChar(11)
  razonSocial String            @unique @map("razon_social") @db.VarChar(180)
  telefono    String?           @db.VarChar(30)
  contacto    String?           @db.VarChar(150)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  tickets     Ticket[]
  contactos   ClienteContacto[]
  iniciativas Iniciativa[]

  @@map("clientes")
}

model ClienteContacto {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  clienteId String   @map("cliente_id") @db.UniqueIdentifier
  nombre    String?  @db.VarChar(150)
  telefono  String?  @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tickets   Ticket[]

  @@unique([clienteId, nombre, telefono])
  @@index([clienteId])
  @@map("cliente_contactos")
}

model Ticket {
  id                String            @id @default(uuid()) @db.UniqueIdentifier
  correlativo       Int               @unique @default(autoincrement())
  clienteId         String            @map("cliente_id") @db.UniqueIdentifier
  ruc               String?           @db.VarChar(11)
  razonSocial       String            @map("razon_social") @db.VarChar(180)
  modulo            String            @db.VarChar(100)
  areaDestino       String            @default("Consultoría") @map("area_destino") @db.NVarChar(40)
  telefono          String?           @db.VarChar(30)
  contacto          String?           @db.VarChar(150)
  contactoId        String?           @map("contacto_id") @db.UniqueIdentifier
  consulta          String?           @db.VarChar(3000)
  prioridad         String            @default("NORMAL")
  canal             String            @default("TELEFONO")
  estado            String            @default("PENDIENTE")
  creadoPorId       String            @map("creado_por_id") @db.UniqueIdentifier
  registradoAt      DateTime          @default(now()) @map("registrado_at")
  asignadoAId       String?           @map("asignado_a_id") @db.UniqueIdentifier
  asignadoAt        DateTime?         @map("asignado_at")
  contactadoAt      DateTime?         @map("contactado_at")
  observaciones     String?           @db.VarChar(3000)
  solucion          String?           @db.VarChar(3000)
  finalizadoAt      DateTime?         @map("finalizado_at")
  finalizadoPorId   String?           @map("finalizado_por_id") @db.UniqueIdentifier
  reabiertoAt       DateTime?         @map("reabierto_at")
  slaVenceAt        DateTime?         @map("sla_vence_at")
  resultadoContacto String?           @map("resultado_contacto") @db.VarChar(40)
  atendidoPorNombre String?           @map("atendido_por_nombre") @db.VarChar(120)
  intentosContacto  Int?              @map("intentos_contacto")
  origen            String?           @db.VarChar(40)
  origenRef         String?           @unique @map("origen_ref") @db.VarChar(60)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  cliente           Cliente           @relation(fields: [clienteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contactoRegistro  ClienteContacto?  @relation(fields: [contactoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creadoPor         Usuario           @relation("TicketsCreados", fields: [creadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asignadoA         Usuario?          @relation("TicketsAsignados", fields: [asignadoAId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  finalizadoPor     Usuario?          @relation("TicketsFinalizados", fields: [finalizadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  historial         TicketHistorial[]

  @@index([estado, registradoAt])
  @@index([asignadoAId, estado])
  @@index([clienteId, registradoAt])
  @@map("tickets")
}

model TicketHistorial {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  ticketId       String   @map("ticket_id") @db.UniqueIdentifier
  accion         String   @db.VarChar(80)
  estadoAnterior String?  @map("estado_anterior")
  estadoNuevo    String?  @map("estado_nuevo")
  usuarioId      String   @map("usuario_id") @db.UniqueIdentifier
  comentario     String?  @db.VarChar(2000)
  metadata       String?  @db.NVarChar(Max)
  createdAt      DateTime @default(now()) @map("created_at")
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ticketId, createdAt])
  @@map("ticket_historial")
}

model RegistroPortal {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  tipo      String   @db.VarChar(40)
  datos     String   @db.NVarChar(Max)
  creadorId String   @map("creador_id") @db.UniqueIdentifier
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  creador   Usuario  @relation(fields: [creadorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tipo, createdAt])
  @@map("registros_portal")
}

model Iniciativa {
  creadorId          String?           @map("creador_id") @db.UniqueIdentifier
  id                 String            @id @default(uuid()) @db.UniqueIdentifier
  codigo             String            @unique @db.VarChar(10)
  titulo             String            @db.VarChar(200)
  descripcion        String            @db.NVarChar(Max)
  cliente            String?           @db.VarChar(160)
  clienteId          String?           @map("cliente_id") @db.UniqueIdentifier
  software           String?           @db.VarChar(120)
  icono              String?           @db.NVarChar(12)
  colorIcono         String?           @map("color_icono") @db.VarChar(7)
  areaId             String            @map("area_id") @db.UniqueIdentifier
  objetivoId         String?           @map("objetivo_id") @db.UniqueIdentifier
  impacto            Int
  esfuerzo           String
  score              Decimal           @default(0) @db.Decimal(5, 2)
  estado             String            @default("Pendiente")
  responsableId      String?           @map("responsable_id") @db.UniqueIdentifier
  porcentajeAvance   Int               @default(0) @map("porcentaje_avance")
  fechaCreacion      DateTime          @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime          @updatedAt @map("fecha_actualizacion")
  fechaInicio        DateTime?         @map("fecha_inicio") @db.Date
  fechaFin           DateTime?         @map("fecha_fin") @db.Date
  deletedAt          DateTime?         @map("deleted_at")
  deletedById        String?           @map("deleted_by_id") @db.UniqueIdentifier
  area               Area              @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  objetivo           ObjetivoNegocio?  @relation(fields: [objetivoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responsable        Usuario?          @relation("Responsable", fields: [responsableId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clienteRef         Cliente?          @relation(fields: [clienteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  progresos          Progreso[]
  eventos            Evento[]
  tareas             TareaIniciativa[]

  @@index([estado], map: "idx_iniciativas_estado")
  @@index([areaId], map: "idx_iniciativas_area")
  @@index([score(sort: Desc)], map: "idx_iniciativas_score")
  @@index([responsableId], map: "idx_iniciativas_responsable")
  @@index([clienteId], map: "idx_iniciativas_cliente")
  @@map("iniciativas")
}

model Progreso {
  id           String     @id @default(uuid()) @db.UniqueIdentifier
  iniciativaId String     @map("iniciativa_id") @db.UniqueIdentifier
  usuarioId    String     @map("usuario_id") @db.UniqueIdentifier
  porcentaje   Int
  comentario   String     @db.VarChar(500)
  createdAt    DateTime   @default(now()) @map("created_at")
  iniciativa   Iniciativa @relation(fields: [iniciativaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario      Usuario    @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([iniciativaId], map: "idx_progresos_iniciativa")
  @@map("progresos")
}

model TareaIniciativa {
  id             String            @id @default(uuid()) @db.UniqueIdentifier
  iniciativaId   String            @map("iniciativa_id") @db.UniqueIdentifier
  titulo         String            @db.VarChar(220)
  estado         String            @default("Pendiente") @db.VarChar(30)
  completada     Boolean           @default(false)
  comentario     String?           @db.VarChar(600)
  prioridad      String            @default("Normal") @db.VarChar(20)
  responsableId  String?           @map("responsable_id") @db.UniqueIdentifier
  recordatorioAt DateTime?         @map("recordatorio_at")
  adjuntos       String            @default("[]") @db.NVarChar(Max)
  fechaInicio    DateTime?         @map("fecha_inicio") @db.Date
  fechaFin       DateTime?         @map("fecha_fin") @db.Date
  completadaAt   DateTime?         @map("completada_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")
  iniciativa     Iniciativa        @relation(fields: [iniciativaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responsable    Usuario?          @relation("TareasAsignadas", fields: [responsableId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  comentarios    TareaComentario[]

  @@index([iniciativaId, estado])
  @@index([responsableId, estado])
  @@map("tareas_iniciativa")
}

model TareaComentario {
  id        String          @id @default(uuid()) @db.UniqueIdentifier
  tareaId   String          @map("tarea_id") @db.UniqueIdentifier
  usuarioId String          @map("usuario_id") @db.UniqueIdentifier
  contenido String          @db.VarChar(600)
  createdAt DateTime        @default(now()) @map("created_at")
  tarea     TareaIniciativa @relation(fields: [tareaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario   Usuario         @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tareaId, createdAt])
  @@map("tarea_comentarios")
}

model Mensaje {
  eliminadoAt    DateTime?         @map("eliminado_at")
  id             String            @id @default(uuid()) @db.UniqueIdentifier
  remitenteId    String            @map("remitente_id") @db.UniqueIdentifier
  destinatarioId String            @map("destinatario_id") @db.UniqueIdentifier
  contenido      String            @db.VarChar(2000)
  tipo           String            @default("Texto")
  archivoNombre  String?           @map("archivo_nombre") @db.VarChar(255)
  archivoMime    String?           @map("archivo_mime") @db.VarChar(120)
  archivoData    String?           @map("archivo_data") @db.NVarChar(Max)
  leidoAt        DateTime?         @map("leido_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  respuestaAId   String?           @map("respuesta_a_id") @db.UniqueIdentifier
  respuestaA     Mensaje?          @relation("MensajeRespuesta", fields: [respuestaAId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  respuestas     Mensaje[]         @relation("MensajeRespuesta")
  reenviadoDeId  String?           @map("reenviado_de_id") @db.UniqueIdentifier
  reenviadoDe    Mensaje?          @relation("MensajeReenvio", fields: [reenviadoDeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reenvios       Mensaje[]         @relation("MensajeReenvio")
  reacciones     MensajeReaccion[]
  remitente      Usuario           @relation("MensajesEnviados", fields: [remitenteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destinatario   Usuario           @relation("MensajesRecibidos", fields: [destinatarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([remitenteId, destinatarioId, createdAt], map: "idx_mensajes_conversacion")
  @@index([destinatarioId, leidoAt], map: "idx_mensajes_no_leidos")
  @@map("mensajes")
}

model MensajeReaccion {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  mensajeId String   @map("mensaje_id") @db.UniqueIdentifier
  usuarioId String   @map("usuario_id") @db.UniqueIdentifier
  emoji     String   @db.NVarChar(8)
  createdAt DateTime @default(now()) @map("created_at")
  mensaje   Mensaje  @relation(fields: [mensajeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([mensajeId, usuarioId, emoji])
  @@map("mensaje_reacciones")
}

model MensajeProgramado {
  id             String    @id @default(uuid()) @db.UniqueIdentifier
  remitenteId    String    @map("remitente_id") @db.UniqueIdentifier
  destinatarioId String    @map("destinatario_id") @db.UniqueIdentifier
  contenido      String    @db.VarChar(2000)
  tipo           String    @default("Texto")
  archivoNombre  String?   @map("archivo_nombre") @db.VarChar(255)
  archivoMime    String?   @map("archivo_mime") @db.VarChar(120)
  archivoData    String?   @map("archivo_data") @db.NVarChar(Max)
  enviarEn       DateTime  @map("enviar_en")
  enviadoAt      DateTime? @map("enviado_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  remitente      Usuario   @relation("MensajesProgramados", fields: [remitenteId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([enviarEn, enviadoAt], map: "idx_programados_pendientes")
  @@map("mensajes_programados")
}

model Huddle {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  salaId        String    @unique @map("sala_id") @db.VarChar(80)
  contexto      String    @db.VarChar(20)
  contextoId    String    @map("contexto_id") @db.VarChar(80)
  iniciadoPorId String    @map("iniciado_por_id") @db.UniqueIdentifier
  estado        String    @default("activa") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at")
  finalizadaAt  DateTime? @map("finalizada_at")
  iniciadoPor   Usuario   @relation("HuddlesIniciados", fields: [iniciadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([contexto, contextoId, estado])
  @@map("huddles")
}

model SolicitudCambio {
  id               String    @id @default(uuid()) @db.UniqueIdentifier
  tipoEntidad      String    @map("tipo_entidad")
  entidadId        String    @map("entidad_id") @db.UniqueIdentifier
  accion           String
  payload          String?   @db.NVarChar(Max)
  snapshot         String?   @db.NVarChar(Max)
  motivo           String    @db.VarChar(500)
  etapas           String    @default("[]") @db.NVarChar(Max)
  etapaActual      Int       @default(0) @map("etapa_actual")
  decisiones       String    @default("[]") @db.NVarChar(Max)
  motivoResolucion String?   @map("motivo_resolucion") @db.VarChar(500)
  estado           String    @default("Pendiente")
  solicitanteId    String    @map("solicitante_id") @db.UniqueIdentifier
  aprobadorId      String?   @map("aprobador_id") @db.UniqueIdentifier
  areaId           String    @map("area_id") @db.UniqueIdentifier
  createdAt        DateTime  @default(now()) @map("created_at")
  resolvedAt       DateTime? @map("resolved_at")
  solicitante      Usuario   @relation("SolicitudesCreadas", fields: [solicitanteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  aprobador        Usuario?  @relation("SolicitudesAprobadas", fields: [aprobadorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  area             Area      @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([areaId, estado], map: "idx_solicitudes_area_estado")
  @@index([solicitanteId, createdAt], map: "idx_solicitudes_solicitante_fecha")
  @@map("solicitudes_cambio")
}

model Evento {
  id           String      @id @default(uuid()) @db.UniqueIdentifier
  titulo       String      @db.VarChar(180)
  descripcion  String?     @db.VarChar(800)
  inicio       DateTime
  fin          DateTime
  icono        String      @default("📅") @db.NVarChar(12)
  colorHex     String      @default("#2F6FED") @map("color_hex") @db.VarChar(7)
  prioridad    String      @default("Normal") @db.VarChar(20)
  estado       String      @default("Programado") @db.VarChar(30)
  areaId       String      @map("area_id") @db.UniqueIdentifier
  creadorId    String      @map("creador_id") @db.UniqueIdentifier
  asignadoId   String?     @map("asignado_id") @db.UniqueIdentifier
  iniciativaId String?     @map("iniciativa_id") @db.UniqueIdentifier
  software     String?     @db.VarChar(120)
  plataforma   String?     @db.VarChar(30)
  empresa      String?     @db.VarChar(160)
  sala         String?     @db.VarChar(60)
  comentarios  String?     @db.VarChar(800)
  createdAt    DateTime    @default(now()) @map("created_at")
  deletedAt    DateTime?   @map("deleted_at")
  area         Area        @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creador      Usuario     @relation("EventosCreados", fields: [creadorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asignado     Usuario?    @relation("EventosAsignados", fields: [asignadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  iniciativa   Iniciativa? @relation(fields: [iniciativaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([areaId, inicio])
  @@index([asignadoId, inicio])
  @@map("eventos")
}

model Requerimiento {
  id             String    @id @default(uuid()) @db.UniqueIdentifier
  titulo         String    @db.VarChar(180)
  descripcion    String?   @db.VarChar(800)
  cantidad       Int       @default(1)
  prioridad      String    @default("Normal") @db.VarChar(20)
  estado         String    @default("Solicitado") @db.VarChar(30)
  fechaNecesaria DateTime? @map("fecha_necesaria") @db.Date
  areaId         String    @map("area_id") @db.UniqueIdentifier
  usuarioId      String    @map("usuario_id") @db.UniqueIdentifier
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  area           Area      @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([areaId, estado])
  @@map("requerimientos")
}

model FlujoArea {
  id            String             @id @default(uuid()) @db.UniqueIdentifier
  titulo        String             @db.VarChar(180)
  descripcion   String?            @db.VarChar(500)
  archivoNombre String             @map("archivo_nombre") @db.VarChar(255)
  archivoData   String             @map("archivo_data") @db.NVarChar(Max)
  areaId        String             @map("area_id") @db.UniqueIdentifier
  usuarioId     String             @map("usuario_id") @db.UniqueIdentifier
  createdAt     DateTime           @default(now()) @map("created_at")
  deletedAt     DateTime?          @map("deleted_at")
  area          Area               @relation(fields: [areaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario       Usuario            @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versiones     DocumentoVersion[]

  @@index([areaId, createdAt])
  @@map("flujos_area")
}

model DocumentoVersion {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  flujoId       String    @map("flujo_id") @db.UniqueIdentifier
  version       Int
  archivoNombre String    @map("archivo_nombre") @db.VarChar(255)
  archivoData   String    @map("archivo_data") @db.NVarChar(Max)
  mime          String    @default("application/pdf") @db.VarChar(120)
  usuarioId     String    @map("usuario_id") @db.UniqueIdentifier
  createdAt     DateTime  @default(now()) @map("created_at")
  flujo         FlujoArea @relation(fields: [flujoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([flujoId, version])
  @@index([flujoId, createdAt])
  @@map("documento_versiones")
}

model Notificacion {
  id          String    @id @default(uuid()) @db.UniqueIdentifier
  usuarioId   String    @map("usuario_id") @db.UniqueIdentifier
  tipo        String    @db.VarChar(40)
  titulo      String    @db.VarChar(180)
  mensaje     String    @db.VarChar(600)
  enlace      String?   @db.VarChar(240)
  datos       String    @default("{}") @db.NVarChar(Max)
  leidaAt     DateTime? @map("leida_at")
  archivadaAt DateTime? @map("archivada_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([usuarioId, leidaAt, createdAt])
  @@map("notificaciones")
}

model Prospecto {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  fechaContacto DateTime  @map("fecha_contacto") @db.Date
  nombreCliente String    @map("nombre_cliente") @db.VarChar(160)
  ruc           String?   @db.VarChar(20)
  empresa       String?   @db.VarChar(160)
  celular       String?   @db.VarChar(30)
  correo        String?   @db.VarChar(160)
  canal         String    @db.VarChar(60)
  sistemaEjb    String    @map("sistema_ejb") @db.VarChar(400)
  notas         String?   @db.VarChar(2000)
  creadoPorId   String?   @map("creado_por_id") @db.UniqueIdentifier
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  creadoPor     Usuario?  @relation(fields: [creadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fechaContacto], map: "idx_prospectos_fecha")
  @@map("prospectos")
}

model MetaMarketing {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  anio        Int
  mes         Int
  metaMensual Int      @default(80) @map("meta_mensual")
  metaSemanal Int      @default(20) @map("meta_semanal")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([anio, mes], map: "uq_meta_marketing_periodo")
  @@map("metas_marketing")
}
